# Versions of the tools the gates need, in one place: the Makefile installs
# these and CI reads the same file, so a local run and a CI run cannot end up
# on different versions of a linter and disagree about the same code.
GOLANGCI_LINT_VERSION=v2.12.2
BUF_VERSION=v1.71.0
PROTOC_GEN_GO_VERSION=v1.36.11
PROTOC_GEN_GO_GRPC_VERSION=v1.5.1
GOVULNCHECK_VERSION=v1.7.0
ACTIONLINT_VERSION=v1.7.12
