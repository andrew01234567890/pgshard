{
  "title": "pgshard",
  "uid": "pgshard-overview",
  "schemaVersion": 39,
  "tags": ["pgshard"],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {"type": "row", "title": "Topology & HA", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}},
    {"type": "stat", "title": "Primaries", "gridPos": {"h": 6, "w": 4, "x": 0, "y": 1},
     "targets": [{"expr": "sum(pgshard_agent_primary)"}]},
    {"type": "timeseries", "title": "Replication lag (bytes)", "gridPos": {"h": 6, "w": 10, "x": 4, "y": 1},
     "targets": [{"expr": "pgshard_agent_replication_lag_bytes", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "Operator failovers / reconcile errors", "gridPos": {"h": 6, "w": 10, "x": 14, "y": 1},
     "targets": [
       {"expr": "increase(pgshard_operator_failovers_total[1h])", "legendFormat": "failovers (1h)"},
       {"expr": "rate(controller_runtime_reconcile_errors_total[5m])", "legendFormat": "reconcile errors/s"}]},
    {"type": "row", "title": "Router & transactions", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 7}},
    {"type": "timeseries", "title": "Sessions / connections", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 8},
     "targets": [
       {"expr": "sum(pgshard_router_active_sessions)", "legendFormat": "active sessions"},
       {"expr": "sum(rate(pgshard_router_connections_total[5m]))", "legendFormat": "connections/s"}]},
    {"type": "timeseries", "title": "Queries by plan kind", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 8},
     "targets": [{"expr": "sum by (kind) (rate(pgshard_router_queries_total[5m]))", "legendFormat": "{{kind}}"}]},
    {"type": "timeseries", "title": "Refusals by SQLSTATE", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 8},
     "targets": [{"expr": "sum by (sqlstate) (rate(pgshard_router_refusals_total[5m]))", "legendFormat": "{{sqlstate}}"}]},
    {"type": "timeseries", "title": "Per-shard latency p99", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 14},
     "targets": [{"expr": "histogram_quantile(0.99, sum by (shard, le) (rate(pgshard_router_shard_latency_seconds_bucket[5m])))", "legendFormat": "{{shard}}"}]},
    {"type": "timeseries", "title": "2PC outcomes", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 14},
     "targets": [
       {"expr": "sum(rate(pgshard_router_twopc_commits_total[5m]))", "legendFormat": "commits/s"},
       {"expr": "sum(rate(pgshard_router_twopc_aborts_total[5m]))", "legendFormat": "aborts/s"},
       {"expr": "pgshard_controller_in_doubt_transactions", "legendFormat": "in doubt"},
       {"expr": "pgshard_controller_in_doubt_oldest_age_seconds", "legendFormat": "oldest in-doubt age (s)"}]},
    {"type": "timeseries", "title": "Failover buffering & plan cache", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 14},
     "targets": [
       {"expr": "sum(rate(pgshard_router_buffering_events_total[5m]))", "legendFormat": "buffered/s"},
       {"expr": "histogram_quantile(0.99, sum by (le) (rate(pgshard_router_buffering_seconds_bucket[5m])))", "legendFormat": "buffer wait p99 (s)"},
       {"expr": "sum(rate(pgshard_router_plan_cache_hits_total[5m])) / (sum(rate(pgshard_router_plan_cache_hits_total[5m])) + sum(rate(pgshard_router_plan_cache_misses_total[5m])))", "legendFormat": "plan cache hit ratio"}]},
    {"type": "row", "title": "Pooler", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 20}},
    {"type": "timeseries", "title": "Backends", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 21},
     "targets": [
       {"expr": "sum(pgshard_pooler_backends_live)", "legendFormat": "live"},
       {"expr": "sum(pgshard_pooler_backends_idle)", "legendFormat": "idle"},
       {"expr": "sum(rate(pgshard_pooler_pool_waits_total[5m]))", "legendFormat": "waits/s"}]},
    {"type": "timeseries", "title": "Dials & prepared cache", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 21},
     "targets": [
       {"expr": "sum by (result) (rate(pgshard_pooler_backend_dials_total[5m]))", "legendFormat": "dials {{result}}"},
       {"expr": "sum(rate(pgshard_pooler_prepared_cache_hits_total[5m]))", "legendFormat": "prepared hits/s"},
       {"expr": "sum(rate(pgshard_pooler_prepared_cache_misses_total[5m]))", "legendFormat": "prepared misses/s"}]},
    {"type": "timeseries", "title": "Stream lag (bytes)", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 21},
     "targets": [{"expr": "pgshard_pooler_stream_lag_bytes", "legendFormat": "{{pod}}"}]},
    {"type": "row", "title": "Reshard & DDL", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27}},
    {"type": "timeseries", "title": "Workflows by state", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 28},
     "targets": [{"expr": "sum by (kind, state) (pgshard_controller_workflows)", "legendFormat": "{{kind}}/{{state}}"}]},
    {"type": "timeseries", "title": "Workflow progress", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 28},
     "targets": [
       {"expr": "pgshard_controller_workflow_progress", "legendFormat": "{{kind}} {{id}}"},
       {"expr": "pgshard_controller_cutover_paused", "legendFormat": "paused at cutover"}]},
    {"type": "timeseries", "title": "DDL migrations by state", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 28},
     "targets": [{"expr": "sum by (state) (pgshard_controller_ddl_migrations)", "legendFormat": "{{state}}"}]},
    {"type": "row", "title": "Backups & slots", "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}},
    {"type": "timeseries", "title": "Backup age (s)", "gridPos": {"h": 6, "w": 8, "x": 0, "y": 35},
     "targets": [{"expr": "pgshard_agent_backup_last_age_seconds", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "Backup size (bytes)", "gridPos": {"h": 6, "w": 8, "x": 8, "y": 35},
     "targets": [{"expr": "pgshard_agent_backup_last_size_bytes", "legendFormat": "{{pod}}"}]},
    {"type": "timeseries", "title": "Slot wal_status (non-reserved)", "gridPos": {"h": 6, "w": 8, "x": 16, "y": 35},
     "targets": [{"expr": "pgshard_agent_slot_wal_status{wal_status!~\"reserved|extended\"}", "legendFormat": "{{slot}} {{wal_status}}"}]}
  ]
}
