# syntax=docker/dockerfile:1.7
# Builds one control-plane binary (operator, controller or admin) into a distroless image.
# Example: docker build -f Dockerfile.control --build-arg CMD=pgshard-admin -t pgshard-admin:dev .
ARG CMD=pgshard-operator

FROM golang:1.26-bookworm AS build
ARG CMD
ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath \
      -ldflags "-s -w -X github.com/andrew01234567890/pgshard/internal/buildinfo.Version=${VERSION} -X github.com/andrew01234567890/pgshard/internal/buildinfo.Commit=${COMMIT} -X github.com/andrew01234567890/pgshard/internal/buildinfo.Date=${DATE}" \
      -o /out/${CMD} ./cmd/${CMD}

FROM gcr.io/distroless/static-debian12:nonroot
ARG CMD
LABEL org.opencontainers.image.source="https://github.com/andrew01234567890/pgshard" \
      org.opencontainers.image.title="${CMD}"
COPY --from=build /out/${CMD} /usr/local/bin/${CMD}
COPY --from=build /out/${CMD} /entrypoint
USER 65532:65532
ENTRYPOINT ["/entrypoint"]
